# --- Gemini (Google AI Studio → Get API key) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Neon Postgres (Dashboard → Connect → pooled connection string) ---
DATABASE_URL=

# --- Telegram (@BotFather → /newbot ; chat id from @userinfobot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=any-long-random-string

# --- Gmail (Google Account → Security → 2-Step Verification → App passwords) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
NEWSLETTER_FROM_NAME=The Dispatch

# --- Optional live news API (gnews.io free key) ---
GNEWS_API_KEY=

# --- App ---
CRON_SECRET=any-long-random-string
APP_URL=https://your-app.vercel.app
SEND_BATCH_SIZE=40
